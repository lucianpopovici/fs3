#!/bin/sh
# postinst — runs once after package files are extracted.
#
# Persists the install-wizard answers into ${SYNOPKG_PKGVAR}/fs3.conf.
# fs3.conf is data, not code: start-stop-status and index.cgi parse it
# line-by-line and never source it, so wizard values cannot execute as
# shell. The secret key never enters fs3.conf at all — it goes to a
# separate 0600 credentials file (one access_key:secret_key per line,
# the format fs3's --credentials-file expects).
#
# DSM also runs postinst during *upgrades*, with SYNOPKG_PKG_STATUS=
# UPGRADE and none of the wizard_* variables set. Rewriting the conf in
# that case would clobber the user's settings with defaults — most
# dangerously resetting FS3_REQUIRE_AUTH to 0, silently turning a
# SigV4-protected endpoint into an open one. On upgrade, keep the
# existing conf and credentials untouched.

VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/fs3/var}"
CONF_FILE="${VAR_DIR}/fs3.conf"
CRED_FILE="${VAR_DIR}/credentials"
PKG_USER="${SYNOPKG_PKGNAME:-fs3}"

umask 077
mkdir -p "${VAR_DIR}"

if [ "${SYNOPKG_PKG_STATUS}" = "UPGRADE" ] && [ -f "${CONF_FILE}" ]; then
    # Preserve the conf; recover FS3_DATA from it (parsed, never
    # sourced) so the data dir is re-created/chowned below.
    DATA=""
    while IFS= read -r line || [ -n "${line}" ]; do
        case "${line}" in ''|'#'*) continue ;; esac
        key="${line%%=*}"
        val="${line#*=}"
        case "${val}" in
            '"'*'"') val="${val#\"}"; val="${val%\"}" ;;
        esac
        [ "${key}" = "FS3_DATA" ] && DATA="${val}"
    done < "${CONF_FILE}"
    DATA="${DATA:-${VAR_DIR}/data}"
else
    # Fresh install: persist the wizard answers (with sensible
    # fallbacks). Strip CR/LF so a crafted value can't smuggle extra
    # KEY=value lines into the conf.
    sanitize() { printf '%s' "$1" | tr -d '\n\r'; }

    PORT="$(sanitize "${wizard_fs3_port:-9000}")"
    DATA="$(sanitize "${wizard_fs3_data:-${VAR_DIR}/data}")"

    # Bind localhost unless the user explicitly asked for direct LAN
    # access; the supported HTTPS story is DSM's reverse proxy in front
    # (see README).
    BIND="127.0.0.1"
    if [ "${wizard_fs3_expose_lan}" = "true" ]; then
        BIND="0.0.0.0"
    fi

    REQUIRE_AUTH="0"
    if [ "${wizard_fs3_enable_auth}" = "true" ]; then
        REQUIRE_AUTH="1"
        printf '%s:%s\n' "$(sanitize "${wizard_fs3_access_key}")" \
                         "$(sanitize "${wizard_fs3_secret_key}")" > "${CRED_FILE}"
        chmod 600 "${CRED_FILE}"
    fi

    cat > "${CONF_FILE}" <<EOF
# fs3 configuration — generated by the install wizard.
# One KEY=value per line. This file is parsed, never sourced as shell.
# Credentials live in ${CRED_FILE} (one access_key:secret_key per line).
# Edit and restart the package (Package Center > fs3 > Stop/Run) to apply.
FS3_PORT=${PORT}
FS3_BIND=${BIND}
FS3_DATA=${DATA}
FS3_REQUIRE_AUTH=${REQUIRE_AUTH}
FS3_GC_INTERVAL=60
FS3_GC_MAX_AGE=86400
# /healthz + Prometheus /metrics on 127.0.0.1:<port>; 0 disables.
FS3_METRICS_PORT=9101
EOF
fi

mkdir -p "${DATA}"

# The service runs as the DSM-assigned package user, but postinst may run
# with more privilege — make sure the package user owns what it must
# write. VAR_DIR is ours by construction (recursive chown is safe). The
# data dir may be a pre-existing user folder, so chown only the directory
# itself, never its contents; start-stop-status probes writability before
# launch and reports a readable error if this wasn't enough.
if [ "$(id -u)" = "0" ] && id "${PKG_USER}" >/dev/null 2>&1; then
    chown -R "${PKG_USER}" "${VAR_DIR}" 2>/dev/null
    chown "${PKG_USER}" "${DATA}" 2>/dev/null
fi

exit 0
