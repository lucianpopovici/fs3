#!/bin/sh
# start-stop-status — DSM package lifecycle control for fs3.
#
# DSM calls this with one of: start | stop | status | log
# Environment provided by DSM:
#   SYNOPKG_PKGDEST       — where package.tgz was extracted (our install root)
#   SYNOPKG_PKGVAR        — per-package writable var dir (/var/packages/fs3/var)
#   SYNOPKG_PKGNAME       — "fs3"
#   SYNOPKG_TEMP_LOGFILE  — write a message here to surface it in the DSM UI

PKG_DIR="${SYNOPKG_PKGDEST:-/var/packages/fs3/target}"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/fs3/var}"

BIN="${PKG_DIR}/bin/fs3"
PID_FILE="${VAR_DIR}/fs3.pid"          # the watchdog's PID
CHILD_PID_FILE="${VAR_DIR}/fs3.child.pid"  # the fs3 process itself
STOP_FILE="${VAR_DIR}/fs3.stop"        # presence = "don't respawn"
LOG_FILE="${VAR_DIR}/fs3.log"         # fs3's own log; fs3 rotates it (--log-file)
START_LOG="${VAR_DIR}/fs3.start.log"  # this script, the watchdog and fs3's stderr
CONF_FILE="${VAR_DIR}/fs3.conf"
CRED_FILE="${VAR_DIR}/credentials"

RESTART_FILE="${VAR_DIR}/fs3.restart"  # presence = "respawn now, no backoff"
CONF_LIB="${PKG_DIR}/lib/fs3-conf.sh"

# The conf schema (keys, types, defaults, flag mapping) is shared with
# the DSM tile's settings form: lib/fs3-conf.sh. fs3.conf is parsed
# line-by-line there and NEVER sourced: its values come from the install
# wizard and the settings form, and sourcing would let a crafted value
# (e.g. `"; reboot; "`) execute as shell. Unknown keys are ignored and
# invalid values fall back to the default with a line in the log.
#
# Defaults worth knowing: fs3 binds 127.0.0.1 (TLS comes from DSM's
# reverse proxy in front, see README) and trusts X-Forwarded-For from
# that proxy (FS3_TRUSTED_PROXY=127.0.0.1), so throttling and policy IP
# conditions see real clients.
if [ ! -f "${CONF_LIB}" ]; then
    echo "fs3: missing ${CONF_LIB}; reinstall the package" >> "${START_LOG}"
    [ -n "${SYNOPKG_TEMP_LOGFILE}" ] && echo "fs3: missing ${CONF_LIB}; reinstall the package" > "${SYNOPKG_TEMP_LOGFILE}"
    exit 1
fi
. "${CONF_LIB}"

load_conf() {
    fs3_conf_defaults "${VAR_DIR}"
    fs3_conf_load "${CONF_FILE}" 2>> "${START_LOG}"
}

# Abort a start with a message the user can actually find: the package
# log, and the DSM UI via SYNOPKG_TEMP_LOGFILE.
fail_start() {
    echo "fs3: $1" >> "${START_LOG}"
    if [ -n "${SYNOPKG_TEMP_LOGFILE}" ]; then
        echo "$1" > "${SYNOPKG_TEMP_LOGFILE}"
    fi
    exit 1
}

# mkdir -p succeeding is not proof of writability: the data folder may
# exist but be unwritable by the package user (typical when it points at
# a shared folder whose permissions weren't granted). Probe before
# launching so the failure is a readable message, not a crash loop.
preflight_data_dir() {
    mkdir -p "${FS3_DATA}" 2>/dev/null
    probe="${FS3_DATA}/.fs3-write-probe.$$"
    if ! ( : > "${probe}" ) 2>/dev/null; then
        fail_start "cannot write to data folder '${FS3_DATA}' as user '$(id -un 2>/dev/null || echo unknown)'. Grant this user write access in DSM (Control Panel > Shared Folder > Edit > Permissions), or point FS3_DATA in ${CONF_FILE} at a folder the package owns (e.g. ${VAR_DIR}/data)."
    fi
    rm -f "${probe}"
}

# Print fs3's arguments, one per line, from the current conf. Returns 1
# (with a message on stderr) when authentication is on but there is no
# credentials file.
build_args() {
    fs3_conf_args "${VAR_DIR}"
    # SSE-S3 keys: created once when the setting is on, then always
    # passed while the file exists (objects sealed with them must stay
    # readable even if the setting is turned off again).
    SSE_FILE="${VAR_DIR}/sse.keys"
    if [ "${FS3_SSE_S3}" = "1" ] && [ ! -s "${SSE_FILE}" ]; then
        key=$(od -An -tx1 -N32 /dev/urandom 2>/dev/null | tr -d ' \n')
        if [ "${#key}" -ne 64 ]; then
            echo "cannot generate an SSE-S3 key (od /dev/urandom failed)" >&2
            return 1
        fi
        ( umask 077; printf '# fs3 SSE-S3 keys: BACK THIS FILE UP. First line = key for new objects.\nk1 %s\n' "${key}" > "${SSE_FILE}" )
        echo "created a new SSE-S3 key file ${SSE_FILE}: back it up apart from the data" >&2
    fi
    if [ -s "${SSE_FILE}" ]; then
        chmod 600 "${SSE_FILE}" 2>/dev/null
        printf '%s\n' --sse-key-file "${SSE_FILE}"
    fi
    if [ "${FS3_REQUIRE_AUTH}" = "1" ]; then
        # Credentials live in a 0600 file, passed via --credentials-file
        # so the secret never appears on the command line (visible in ps).
        # Migrate from an old-format conf that still carries the keys.
        if [ ! -f "${CRED_FILE}" ] && [ -n "${FS3_ACCESS_KEY}" ]; then
            ( umask 077
              printf '%s:%s\n' "${FS3_ACCESS_KEY}" "${FS3_SECRET_KEY}" > "${CRED_FILE}" )
        fi
        if [ ! -f "${CRED_FILE}" ]; then
            echo "authentication is enabled (FS3_REQUIRE_AUTH=1) but ${CRED_FILE} does not exist. Create it with one access_key:secret_key per line, or set FS3_REQUIRE_AUTH=0 in ${CONF_FILE}." >&2
            return 1
        fi
        chmod 600 "${CRED_FILE}" 2>/dev/null
        printf '%s\n' --credentials-file "${CRED_FILE}" --require-auth

        # Identity of the first credential: its :user field, else the key.
        legacy="${FS3_LEGACY_OWNER}"
        if [ -z "${legacy}" ]; then
            legacy=$(grep -v '^[[:space:]]*#' "${CRED_FILE}" \
                | awk -F: 'NF >= 2 { gsub(/[[:space:]]+$/, ""); \
                                     print (NF >= 3 ? $3 : $1); exit }')
        fi
        [ -n "${legacy}" ] && printf '%s\n' --legacy-owner "${legacy}"
        [ -n "${FS3_ADMIN}" ] && printf '%s\n' --admin "${FS3_ADMIN}"
    fi
    return 0
}

# Watchdog: run fs3 in the foreground and respawn it if it exits without
# being asked to stop (STOP_FILE). The conf is re-read before every
# (re)start, so the DSM tile applies new settings by writing the conf,
# creating RESTART_FILE and stopping the fs3 child: the watchdog then
# respawns it at once with the new arguments. Unrequested exits back off
# 1s → 60s so a crash-loop (bad config, port taken) idles instead of
# cooking a core; a run that survives 60s resets the backoff.
#
# This is the FALLBACK supervision model: the watchdog itself is not
# supervised, so a killed watchdog means no auto-restart until the next
# DSM start. DSM-native service supervision is the preferred answer once
# verified on real hardware — see
# docs/synology-readiness/08-service-supervision/CLAUDE.md.
# fs3 writes and rotates fs3.log itself. fs3.start.log only collects
# startup failures, crash output and this script's messages, so it stays
# small; trim it to its last 128 KiB when it passes 256 KiB.
trim_start_log() {
    [ -f "${START_LOG}" ] || return 0
    sz=$(wc -c < "${START_LOG}" 2>/dev/null || echo 0)
    if [ "${sz}" -gt 262144 ]; then
        tail -c 131072 "${START_LOG}" > "${START_LOG}.tmp" 2>/dev/null \
            && cat "${START_LOG}.tmp" > "${START_LOG}"
        rm -f "${START_LOG}.tmp"
    fi
}

watchdog() {
    backoff=1
    while [ ! -f "${STOP_FILE}" ]; do
        trim_start_log
        load_conf
        started=$(date +%s)
        if args="$(build_args 2>> "${START_LOG}")"; then
            set --
            while IFS= read -r a; do
                set -- "$@" "${a}"
            done <<ARGS_EOF
${args}
ARGS_EOF
            rm -f "${RESTART_FILE}"
            "${BIN}" "$@" &
            echo $! > "${CHILD_PID_FILE}"
            wait $!
            rc=$?
            rm -f "${CHILD_PID_FILE}"
        else
            rc=1
        fi
        [ -f "${STOP_FILE}" ] && break
        if [ -f "${RESTART_FILE}" ]; then
            echo "fs3 restarting to apply new settings" >> "${START_LOG}"
            backoff=1
            continue
        fi
        echo "fs3 exited unexpectedly (rc=${rc}); restarting in ${backoff}s" \
            >> "${START_LOG}"
        sleep "${backoff}"
        now=$(date +%s)
        if [ $((now - started)) -ge 60 ]; then
            backoff=1
        else
            backoff=$((backoff * 2))
            [ "${backoff}" -gt 60 ] && backoff=60
        fi
    done
    rm -f "${PID_FILE}"
}

start_daemon() {
    mkdir -p "${VAR_DIR}"
    preflight_data_dir

    # Fail the start with a readable message instead of crash-looping.
    if ! msg="$(build_args 2>&1 >/dev/null)"; then
        fail_start "${msg}"
    fi

    # Launch the watchdog; it records fs3's own PID in CHILD_PID_FILE.
    # fs3 logs to stderr; redirect to file.
    rm -f "${STOP_FILE}" "${RESTART_FILE}"
    watchdog >> "${START_LOG}" 2>&1 &
    echo $! > "${PID_FILE}"
}

# Kill a PID gracefully: TERM, wait up to 10s, then KILL.
kill_and_wait() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null || return 0
    kill "$1" 2>/dev/null
    i=0
    while [ $i -lt 10 ] && kill -0 "$1" 2>/dev/null; do
        sleep 1
        i=$((i + 1))
    done
    kill -9 "$1" 2>/dev/null
    return 0
}

stop_daemon() {
    # Order matters: raise the stop flag first so the watchdog won't
    # respawn, then stop fs3, then reap the watchdog (it may be mid-
    # backoff sleep rather than waiting on the child).
    touch "${STOP_FILE}"
    if [ -f "${CHILD_PID_FILE}" ]; then
        kill_and_wait "$(cat "${CHILD_PID_FILE}")"
        rm -f "${CHILD_PID_FILE}"
    fi
    if [ -f "${PID_FILE}" ]; then
        WPID="$(cat "${PID_FILE}")"
        # Give the watchdog a moment to notice and exit on its own.
        i=0
        while [ $i -lt 3 ] && [ -n "${WPID}" ] && kill -0 "${WPID}" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        kill_and_wait "${WPID}"
        rm -f "${PID_FILE}"
    fi
    rm -f "${STOP_FILE}"
}

daemon_status() {
    if [ -f "${PID_FILE}" ]; then
        PID="$(cat "${PID_FILE}")"
        if [ -n "${PID}" ] && kill -0 "${PID}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

load_conf

case "$1" in
    start)
        if daemon_status; then
            exit 0
        fi
        start_daemon
        exit 0
        ;;
    stop)
        stop_daemon
        exit 0
        ;;
    status)
        if daemon_status; then
            exit 0
        else
            # DSM convention: 3 = stopped/not running.
            exit 3
        fi
        ;;
    log)
        echo "${LOG_FILE}"
        exit 0
        ;;
    *)
        echo "usage: $0 {start|stop|status|log}"
        exit 1
        ;;
esac
