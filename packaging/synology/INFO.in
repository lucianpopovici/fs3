package="fs3"
version="__VERSION__"
os_min_ver="7.0-40000"
displayname="fs3 Object Storage"
description="fs3 — a single-node, S3-compatible object storage server. A small, auditable, self-contained S3 endpoint that round-trips with the AWS CLI, boto3, and other S3 clients. Stores objects on a folder you choose."
maintainer="Lucian"
arch="avoton x86_64 apollolake braswell broadwell broadwellnk denverton geminilake grantley kvmx64 purley v1000 r1000 epyc7002"
beta="false"
report_url=""
silent_install="yes"
silent_upgrade="yes"
silent_uninstall="yes"
install_dep_packages=""
thirdparty="yes"
support_conf_folder="yes"
startable="yes"
ctl_stop="yes"
dsmuidir="ui"
dsmappname="SYNO.SDS.fs3.Application"
adminport="9000"
adminprotocol="http"
adminurl=""
